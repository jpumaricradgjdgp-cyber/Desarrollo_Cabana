# Este archivo muestra nombres y formatos. Spring lee variables del entorno.
# Usa scripts/iniciar-supabase.ps1 para cargar un .env local sin incluirlo en Git.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_URL=https://eqetpyfsixikpvvcompq.supabase.co
SUPABASE_PUBLISHABLE_KEY=TU-CLAVE-PUBLICABLE-O-ANON
SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.eqetpyfsixikpvvcompq
SUPABASE_DB_PASSWORD=TU-CONTRASENA-BASE-DE-DATOS
# Solo backend; usar la clave legacy service_role JWT para firmar rutas de Storage.
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_ORIGIN=http://localhost:8081
# false únicamente para pruebas en localhost. true al publicar con HTTPS.
SECURE_COOKIES=false
PORT=8081
